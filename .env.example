# Web3Forms access key for contact form submissions
VITE_WEB3FORMS_KEY=your_web3forms_key_here

# Razorpay (client-safe: key_id only)
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx

# Admin API (server-side only — set in Vercel env vars, never commit values).
# Without these, /api/login, /api/posts and /api/ctas answer 503.
JWT_SECRET=generate-a-long-random-string-per-environment
ADMIN_PASSWORD=choose-a-strong-unique-password

# Razorpay (server-side only — set in Vercel env vars, never commit values).
# Without these, /api/razorpay/order and /api/razorpay/verify answer 503.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
